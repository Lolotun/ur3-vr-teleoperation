# Copy to .env and set the actual controller IP. Never commit .env.
ROBOT_IP=192.168.50.85
ROS_DOMAIN_ID=11
ROS_LOCALHOST_ONLY=1
ROS_TCP_PORT=10000

# Fresh source build (default):
TELEOP_IMAGE=ur3-vr-teleoperation:humble
# To use the existing workshop image instead, set:
# TELEOP_IMAGE=ur3-vr-workshop:humble

# Last working real-robot settings: XYZ only; TCP rotation remains disabled.
SPEEDL_SEND_HZ=8.0
SPEEDL_MAX_LINEAR_SPEED=0.020
SPEEDL_MAX_ANGULAR_SPEED=0.0
SPEEDL_ACCELERATION=0.10
SPEEDL_COMMAND_DURATION=0.14
SPEEDL_STALE_TIMEOUT_SEC=0.18
SPEEDL_CONNECT_TIMEOUT_SEC=0.06
SPEEDL_DEADBAND=0.002
SPEEDL_ENABLE_STATE_FEEDBACK=true
ENABLE_GRIPPER=true
GRIPPER_FORCE=20
