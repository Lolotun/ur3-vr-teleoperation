# Copy to .env and set the actual controller IP. Never commit .env.
ROBOT_IP=192.168.88.56
ROS_DOMAIN_ID=11
ROS_LOCALHOST_ONLY=1
ROS_TCP_PORT=10000

# Fresh source build (default):
TELEOP_IMAGE=ur3-vr-teleoperation:humble
# To use the existing workshop image instead, set:
# TELEOP_IMAGE=ur3-vr-workshop:humble

# Last working real-robot settings: XYZ only; TCP rotation remains disabled.
SPEEDL_SEND_HZ=8.0
SPEEDL_MAX_LINEAR_SPEED=0.030
SPEEDL_MAX_ANGULAR_SPEED=0.0
SPEEDL_ACCELERATION=0.10
SPEEDL_COMMAND_DURATION=0.14
SPEEDL_STALE_TIMEOUT_SEC=0.18
SPEEDL_CONNECT_TIMEOUT_SEC=0.06
SPEEDL_DEADBAND=0.002
SPEEDL_ENABLE_STATE_FEEDBACK=true
ENABLE_GRIPPER=true
GRIPPER_FORCE=20

# RTDE position mode. Preview reads feedback but does not upload a control script.
RTDE_ENABLE_MOTION=true
RTDE_ENABLE_GRIPPER=true
# Read-only GET POS/PRE/OBJ/STA, also available without enabling gripper motion.
RTDE_ENABLE_GRIPPER_FEEDBACK=true
# RTDE source selection; switch at runtime with scripts/run.sh mode VR|POLICY|STOP.
TELEOP_CONTROL_MODE=STOP
POLICY_MAX_LINEAR_SPEED=0.020
POLICY_MAX_ANGULAR_SPEED=0.12
# Clip accepted policy goals relative to actual TCP (metres / radians; 10 degrees).
POLICY_TARGET_DISTANCE=0.03
POLICY_TARGET_ROTATION=0.17453292519943295
# Reject the original prediction above these distances, before clipping.
POLICY_MAX_DISTANCE=0.20
POLICY_MAX_ROTATION=0.5
# CB3 UR3: 125; verify controller generation before changing.
RTDE_FREQUENCY=125.0
RTDE_POSITION_SCALE=1.0
# Standard URDF base_link -> UR base rotation; verify in preview on your installation.
RTDE_MAPPING_YAW_DEG=180.0
RTDE_MAX_DISPLACEMENT=0.5
RTDE_MAX_ROTATION=1.57079632679
RTDE_MAX_LINEAR_SPEED=0.14
RTDE_MAX_ANGULAR_SPEED=1.2
RTDE_POSITION_GAIN = 2.5
RTDE_ROTATION_GAIN = 2.0
RTDE_COMMAND_TIMEOUT=0.25
RTDE_FEEDBACK_TIMEOUT=0.25
RTDE_LOOKAHEAD_TIME=0.1
# Anti-windup joint lead in radians; keep both below the hard tracking limit.
RTDE_LEAD_SOFT_START=0.06
RTDE_LEAD_SOFT_LIMIT=0.10
# Floor surface is 1 cm below base_link, in meters.
RTDE_FLOOR_Z=-0.01
RTDE_GAIN=300.0
RTDE_POSE_CHECK_MODE=local

# Active TCP on UR pendant: +150 mm along tool Z (meters here).
RTDE_TCP_XYZ=[0.0, 0.0, 0.150]
