# Local configuration and credentials
.env
.env.*
!.env.example
*.keystore
*.pem

# Python and ROS build products
__pycache__/
*.py[cod]
.venv/
**/ros2_ws/build/
**/ros2_ws/install/
**/ros2_ws/log/
*.egg-info/

# Unity has its own ignore file, retained in unity/.gitignore
*.slnx

# Meta SDK is resolved from the registry; local embedded copies stay untracked.
/unity/Packages/com.meta.xr.sdk.core/
/unity/Packages/com.meta.xr.sdk.core.meta

# Generated artifacts belong outside source control
/dist/
/data/
/recordings/
*.docker.tar
*.docker.tar.gz
*.apk
*.aab
.DS_Store
